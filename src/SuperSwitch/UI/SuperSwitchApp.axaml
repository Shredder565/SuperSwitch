<Application
    x:Class="SuperSwitch.Ava.SuperSwitchApp"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sty="using:FluentAvalonia.Styling"
    xmlns:ext="clr-namespace:SuperSwitch.Ava.Common.Markup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <FontFamily x:Key="JetBrainsMono">avares://SuperSwitch/Assets/Fonts/Mono/#JetBrains Mono</FontFamily>
                </ResourceDictionary>
                <MergeResourceInclude Source="/Assets/Styles/Themes.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <!-- SuperSwitch: one fixed accent colour (the violet of the home screen) instead of the Windows accent colour. -->
        <sty:FluentAvaloniaTheme PreferUserAccentColor="False" PreferSystemTheme="False" CustomAccentColor="#8B96FF" />
        <StyleInclude Source="/Assets/Styles/Styles.xaml" />
    </Application.Styles>
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="{ext:Locale MenuBarHelpAbout}" Click="AboutSuperSwitch_OnClick" />
        </NativeMenu>
    </NativeMenu.Menu>
</Application>
