<UserControl
    x:Class="Ryujinx.Ava.UI.Views.Misc.ConsoleHomeView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:Ryujinx.Ava.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:Ryujinx.Ava.UI.ViewModels"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    Focusable="True"
    mc:Ignorable="d"
    x:DataType="viewModels:MainWindowViewModel">
    <!-- SuperSwitch: console-style home screen. The game played is picked from one row of large tiles;
         everything else (settings, recordings, the full menu) is reached from the buttons at the top right. -->
    <UserControl.Styles>
        <Style Selector="Button.home">
            <Setter Property="Background" Value="#1A1F29" />
            <Setter Property="Foreground" Value="#E8EAF0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.play">
            <Setter Property="Background" Value="#8B96FF" />
            <Setter Property="Foreground" Value="#0B0D12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="28" />
            <Setter Property="Padding" Value="40,0" />
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Foreground" Value="#B4BCCB" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>
    <!-- Always dark, whatever theme the rest of the app uses, so the list and buttons match the dark background. -->
    <ThemeVariantScope RequestedThemeVariant="Dark">
    <Grid Background="#0F1218" RowDefinitions="Auto,Auto,*,Auto">
        <!-- Top bar -->
        <DockPanel Grid.Row="0" Margin="48,24,48,0" LastChildFill="False">
            <TextBlock
                DockPanel.Dock="Left"
                VerticalAlignment="Center"
                FontSize="24"
                FontWeight="Bold"
                Foreground="#E8EAF0"
                Text="SuperSwitch" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10">
                <Button Classes="home" Command="{Binding OpenRecordingsFolder}" Content="Recordings" />
                <Button Classes="home" Click="Settings_Click" Content="Settings" />
                <Button Classes="home" Command="{Binding ToggleConsoleMenu}" Content="Menu" ToolTip.Tip="Show or hide the full menu bar" />
                <Button Classes="home" Command="{Binding ToggleFullscreen}" Content="Full screen" />
            </StackPanel>
        </DockPanel>
        <!-- Selected game -->
        <Grid Grid.Row="1" Margin="48,32,48,24" ColumnDefinitions="Auto,*">
            <Border
                Grid.Column="0"
                Width="260"
                Height="260"
                Background="#1A1F29"
                ClipToBounds="True"
                CornerRadius="20">
                <Image
                    Source="{Binding ConsoleSelectedApplication.Icon, Converter={x:Static helpers:BitmapArrayValueConverter.Instance}}"
                    Stretch="UniformToFill" />
            </Border>
            <StackPanel Grid.Column="1" Margin="44,0,0,0" VerticalAlignment="Center" Spacing="14">
                <TextBlock
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="#8B96FF"
                    Text="READY TO PLAY" />
                <TextBlock
                    FontSize="52"
                    FontWeight="Bold"
                    Foreground="#FFFFFF"
                    MaxLines="2"
                    Text="{Binding ConsoleSelectedApplication.Name, FallbackValue='Add a games folder in Settings', TargetNullValue='Add a games folder in Settings'}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
                <TextBlock
                    FontSize="16"
                    Foreground="#B4BCCB"
                    Text="{Binding ConsoleSelectedApplication.TimePlayedString, StringFormat='Time played: {0}'}" />
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal" Spacing="14">
                    <Button Classes="play" Click="Play_Click" Content="Play" />
                    <Button Classes="home" MinHeight="52" Click="GameOptions_Click" Content="Game options" />
                </StackPanel>
            </StackPanel>
        </Grid>
        <!-- All games, one row -->
        <ListBox
            Name="GameList"
            Grid.Row="2"
            Margin="36,0"
            VerticalAlignment="Top"
            Background="Transparent"
            ContextFlyout="{Binding GridAppContextMenu}"
            DoubleTapped="GameList_DoubleTapped"
            ItemsSource="{Binding AppsObservableList}"
            KeyDown="GameList_KeyDown"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Disabled"
            SelectedItem="{Binding ConsoleSelectedApplication}"
            SelectionMode="Single,AlwaysSelected">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Margin" Value="6" />
                    <Setter Property="Padding" Value="6" />
                    <Setter Property="CornerRadius" Value="16" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="176" Spacing="10">
                        <Panel>
                            <Border ClipToBounds="True" CornerRadius="12">
                                <Image
                                    Width="176"
                                    Height="176"
                                    Source="{Binding Icon, Converter={x:Static helpers:BitmapArrayValueConverter.Instance}}"
                                    Stretch="UniformToFill" />
                            </Border>
                            <Border
                                BorderBrush="#8B96FF"
                                BorderThickness="3"
                                CornerRadius="12"
                                IsVisible="{Binding $parent[ListBoxItem].IsSelected}" />
                        </Panel>
                        <TextBlock
                            FontSize="14"
                            Foreground="#E8EAF0"
                            MaxLines="2"
                            Text="{Binding Name}"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <!-- Key hints -->
        <Border Grid.Row="3" Padding="48,14" BorderBrush="#222835" BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="28">
                <TextBlock Classes="hint" Text="Enter  Play" />
                <TextBlock Classes="hint" Text="Left / Right  Choose game" />
                <TextBlock Classes="hint" Text="F11  Full screen" />
                <TextBlock Classes="hint" Text="F7  Record" />
                <TextBlock Classes="hint" Text="F6  Save replay" />
            </StackPanel>
        </Border>
    </Grid>
    </ThemeVariantScope>
</UserControl>
