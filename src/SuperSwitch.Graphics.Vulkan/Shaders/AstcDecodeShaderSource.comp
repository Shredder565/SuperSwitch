#version 450 core

// SuperSwitch GPU ASTC decoder.
// A direct port of SuperSwitch.Graphics.Texture.Astc.AstcDecoder (C#), including its quirks, so that the
// output is bit-identical to the CPU decoder. One invocation decodes one 128-bit block.

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout (std140, set = 0, binding = 0) uniform astc_params
{
    ivec4 params0; // x = block width, y = block height, z = total blocks, w = level entry count
    ivec4 params1; // x = invocations per dispatch row
};

layout (std430, set = 1, binding = 1) readonly buffer astc_in_s
{
    uvec4 in_blocks[];
};

layout (std430, set = 1, binding = 2) writeonly buffer astc_out_s
{
    uint out_texels[];
};

// Two ivec4 per level/layer entry:
// [0] = (start block, block count x, total blocks, image size x)
// [1] = (image size y * image size z, output texel offset, 0, 0)
layout (std430, set = 1, binding = 3) readonly buffer astc_levels_s
{
    ivec4 level_info[];
};

